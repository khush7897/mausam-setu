# ============================================
# MAUSAM SETU — Environment Configuration
# ============================================

# Database Engine Selection:
# 'auto'   -> Checks MySQL first; if unavailable, auto-falls back to zero-config SQLite
# 'mysql'  -> Force MySQL connection (requires active MySQL service)
# 'sqlite' -> Force local embedded SQLite database
DB_TYPE=auto

# MySQL Configuration (used if DB_TYPE is 'mysql' or 'auto' with MySQL running)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mausam_setu

# SQLite Configuration (optional override path)
# SQLITE_PATH=./mausam_setu.sqlite

# Server Configuration
SERVER_PORT=5000
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=*

# ============================================
# Automated Email Service (Nodemailer — 100% Free)
# ============================================
# To send REAL emails directly to user inboxes:
# 1. Use any Gmail account (e.g. yourname@gmail.com)
# 2. In Google Account > Security > 2-Step Verification > App Passwords, generate a 16-character password
# 3. Paste them below:
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Mausam Setu" <no-reply@mausamsetu.gov.in>

# ============================================
# AI & Meteorological API Integrations
# ============================================
# WeatherGPT AI Engine (OpenAI / OpenRouter / Compatible LLM)
AI_API_KEY=sk-EOew2hJCgYLivbfis17oI563PyAnVhVKTKMnSXA49TTgGDyh
OPENAI_API_KEY=sk-EOew2hJCgYLivbfis17oI563PyAnVhVKTKMnSXA49TTgGDyh

# Weather Observation Data API Key (e.g. OpenWeatherMap)
WEATHER_API_KEY=sk-EOew2hJCgYLivbfis17oI563PyAnVhVKTKMnSXA49TTgGDyh
OPENWEATHER_KEY=sk-EOew2hJCgYLivbfis17oI563PyAnVhVKTKMnSXA49TTgGDyh
